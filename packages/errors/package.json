{
  "name": "@hgdc/errors",
  "version": "0.0.0",
  "description": "Remontée d'erreurs des produits HGDC vers GlitchTip (protocole Sentry) : nettoyée, bornée, non bloquante.",
  "license": "UNLICENSED",
  "homepage": "https://github.com/hugogebel-boop/hgdc-kit/tree/main/packages/errors#readme",
  "bugs": "https://github.com/hugogebel-boop/hgdc-kit/security/advisories/new",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hugogebel-boop/hgdc-kit.git",
    "directory": "packages/errors"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./convex": {
      "types": "./dist/convex.d.ts",
      "default": "./dist/convex.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  }
}
