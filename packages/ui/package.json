{
  "name": "@hgdc/ui",
  "version": "0.15.0",
  "description": "Interface de la H family : jetons de la DA, thèmes, polices et composants.",
  "license": "UNLICENSED",
  "homepage": "https://github.com/hugogebel-boop/hgdc-kit/tree/main/packages/ui#readme",
  "bugs": "https://github.com/hugogebel-boop/hgdc-kit/security/advisories/new",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hugogebel-boop/hgdc-kit.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "styles.css",
    "email-icons",
    "family"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./styles.css": "./styles.css",
    "./package.json": "./package.json",
    "./email-icons/*": "./email-icons/*",
    "./family/*": "./family/*",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.5.0",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "react-email": "^6.11.1"
  },
  "peerDependenciesMeta": {
    "react-email": {
      "optional": true
    }
  },
  "devDependencies": {
    "react-email": "6.11.1"
  }
}
