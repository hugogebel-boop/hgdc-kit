---
import { ICON_PATHS as PATHS, type IconName } from "../core/icons.ts"

/** Icônes du modèle (`core/icons.ts`), dessinées en ligne. `currentColor` suit le texte. */
interface Props {
  name: IconName
  size?: number
  class?: string
}
const { name, size = 18, class: className } = Astro.props
---

<svg
  class:list={["hd-icon", className]}
  aria-hidden="true"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"><path d={PATHS[name]}></path></svg
>
