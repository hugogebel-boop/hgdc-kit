---
import basalte from "../assets/hgdc/basalte.webp?url"
import docsDark from "../assets/hgdc/docs-dark.svg?url"
import docsLight from "../assets/hgdc/docs.svg?url"

/**
 * « Propulsé par Docs | Basalte », comme le pied des pages publiques de Status. Les logos sont
 * ceux de `@hgdc/ui` (le site ne dépend pas du kit, qui demande React) : `family/` pour Docs,
 * `BASALTE_MARK_URI` pour la pierre ; les reprendre de là quand ils changent. En `<img>`, pas en
 * SVG en ligne : les deux thèmes partagent les mêmes `id` de dégradé.
 */
---

<div class="hd-powered">
  <span>Propulsé par</span>
  <span class="hd-powered__brands">
    <a class="hd-powered__link" href="https://docs.hgdc.ch" aria-label="Docs">
      <span class="hd-powered__icon">
        <img class="hd-brand__light" src={docsLight} alt="" width="20" height="20" />
        <img class="hd-brand__dark" src={docsDark} alt="" width="20" height="20" />
      </span>
      <span aria-hidden="true">Docs</span>
    </a>
    <span class="hd-powered__rule" aria-hidden="true"></span>
    <a class="hd-powered__link" href="https://hgdc.ch/logiciels" aria-label="Basalte">
      <span class="hd-powered__icon">
        <img src={basalte} alt="" width="20" height="20" />
      </span>
      <span aria-hidden="true">Basalte</span>
    </a>
  </span>
</div>
