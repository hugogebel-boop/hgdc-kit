---
import data from "virtual:hgdc-docs/config"

import Icon from "./Icon.astro"

// Assistant. Fermé : une barre « Pose une question… » au bas du contenu. Ouvert : un
// panneau à droite qui pousse la page (une feuille qui monte du bas sur téléphone).
// Logique dans `../widget/client.ts`.
const endpoint = new URL("/api/v1/ask", data.config.assistant?.endpoint ?? data.apiEndpoint).toString()
---

<hgdc-assistant data-endpoint={endpoint} data-project={data.config.project} data-name={data.config.name}>
  <section class="hgdc-panel" role="dialog" aria-modal="false" aria-labelledby="hgdc-assistant-title" data-panel inert>
    <div class="hgdc-panel__grip" aria-hidden="true"></div>
    <header class="hgdc-panel__header">
      <h2 id="hgdc-assistant-title"><Icon name="sparkles" />Assistant</h2>
      <div class="hgdc-panel__tools">
        <button type="button" class="hd-icon-button" data-reset aria-label="Nouvelle conversation" title="Nouvelle conversation" hidden>
          <Icon name="rotate" />
        </button>
        <button type="button" class="hd-icon-button" data-close aria-label="Fermer l'assistant" title="Fermer (Échap)">
          <Icon name="x" />
        </button>
      </div>
    </header>

    <div class="hgdc-panel__body" data-log aria-live="polite">
      <div class="hgdc-empty" data-empty>
        <p class="hgdc-empty__title">Pose ta question sur {data.config.name}.</p>
        <p>Je cherche dans les pages de cette documentation et je cite mes sources. Si la réponse n'y est pas, je te le dis.</p>
      </div>
    </div>

    <form class="hgdc-panel__form" data-form>
      <label class="sr-only" for="hgdc-question">Ta question</label>
      <textarea id="hgdc-question" data-input rows="1" maxlength="1000" placeholder="Pose une question…" required></textarea>
      <button type="submit" class="hd-send" data-send aria-label="Envoyer la question"><Icon name="arrow-up" size={16} /></button>
    </form>
    <p class="hgdc-panel__note">
      Réponses générées par IA, à vérifier. Les questions sont traitées en Suisse ou dans l'UE et conservées 90 jours
      pour améliorer cette documentation.
    </p>
  </section>
</hgdc-assistant>

<script>
  import { defineAssistant } from "../widget/client.ts"

  defineAssistant()
</script>
