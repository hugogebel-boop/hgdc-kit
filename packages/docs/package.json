{
  "name": "@hgdc/docs",
  "version": "0.6.2",
  "description": "Modèle de site de HGDC Docs : documentation MDX (docs.json) construite avec Astro Starlight, recherche, versions, llms.txt et assistant.",
  "license": "UNLICENSED",
  "homepage": "https://github.com/hugogebel-boop/hgdc-kit/tree/main/packages/docs#readme",
  "bugs": "https://github.com/hugogebel-boop/hgdc-kit/security/advisories/new",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hugogebel-boop/hgdc-kit.git",
    "directory": "packages/docs"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "hgdc-docs": "./bin/hgdc-docs.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "template",
    "docs.schema.json",
    "!src/**/*.test.ts",
    "!template/.astro",
    "!template/.build"
  ],
  "exports": {
    "./core/*": "./src/core/*.ts",
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "default": "./dist/openapi.js"
    },
    "./integration": "./src/integration.ts",
    "./components/*": "./src/components/*",
    "./styles/*": "./src/styles/*",
    "./docs.schema.json": "./docs.schema.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node bin/hgdc-docs.mjs build example",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "@astrojs/mdx": "8.0.3",
    "@astrojs/starlight": "0.42.6",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@iconify-json/lucide": "1.2.143",
    "@mdx-js/mdx": "3.1.1",
    "astro": "7.3.8",
    "github-slugger": "2.0.0",
    "hast-util-select": "6.0.4",
    "hast-util-to-string": "3.0.1",
    "rehype-parse": "9.0.1",
    "rehype-remark": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-stringify": "11.0.0",
    "unified": "11.0.5",
    "vfile": "6.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
