{
  "name": "@hgdc/assistant",
  "version": "0.4.0",
  "description": "Moteur commun de l'assistant IA des produits HGDC : outils typés (lecture, écriture, confirmation), boucle en flux avec Claude (Anthropic, OpenRouter, Bedrock en UE) ou un modèle au format OpenAI (Infomaniak, en Suisse), tables et gardes Convex, crédits mensuels, clé chiffrée de l'organisation.",
  "license": "UNLICENSED",
  "homepage": "https://github.com/hugogebel-boop/hgdc-kit/tree/main/packages/assistant#readme",
  "bugs": "https://github.com/hugogebel-boop/hgdc-kit/security/advisories/new",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hugogebel-boop/hgdc-kit.git",
    "directory": "packages/assistant"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "default": "./dist/model.js"
    },
    "./secret": {
      "types": "./dist/secret.d.ts",
      "default": "./dist/secret.js"
    },
    "./convex": {
      "types": "./dist/convex.d.ts",
      "default": "./dist/convex.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./providers": {
      "types": "./dist/providers.d.ts",
      "default": "./dist/providers.js"
    },
    "./openai": {
      "types": "./dist/openai.d.ts",
      "default": "./dist/openai.js"
    },
    "./bedrock": {
      "types": "./dist/bedrock.d.ts",
      "default": "./dist/bedrock.js"
    },
    "./clients": {
      "types": "./dist/clients.d.ts",
      "default": "./dist/clients.js"
    },
    "./trifecta": {
      "types": "./dist/trifecta.d.ts",
      "default": "./dist/trifecta.js"
    },
    "./console": {
      "types": "./dist/console.d.ts",
      "default": "./dist/console.js"
    },
    "./console/node": {
      "types": "./dist/console-node.d.ts",
      "default": "./dist/console-node.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.134.0 <1.0.0",
    "convex": "^1.46.0",
    "@anthropic-ai/bedrock-sdk": ">=0.34.4 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "convex": {
      "optional": true
    },
    "@anthropic-ai/bedrock-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "@edge-runtime/vm": "5.0.0",
    "convex": "1.46.0",
    "convex-test": "0.0.61",
    "@anthropic-ai/bedrock-sdk": "0.34.4"
  }
}
