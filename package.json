{
  "name": "hgdc-kit",
  "private": true,
  "description": "Paquets partagés de la H family : @hgdc/config, @hgdc/ui, @hgdc/auth.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '@hgdc/*' build",
    "typecheck": "tsc",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "stack": "bun packages/config/src/cli.ts check",
    "check": "bun run stack && bun run format:check && bun run typecheck && bun run lint && bun run test && bun run build",
    "changeset": "changeset",
    "version": "changeset version && bun install",
    "release": "bun run build && bun scripts/publish.ts"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
