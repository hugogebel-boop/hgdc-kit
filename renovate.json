{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitTypeAll(chore)", "helpers:pinGitHubActionDigests"],
  "timezone": "Europe/Zurich",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "3 days",
  "rangeStrategy": "pin",
  "customManagers": [
    {
      "description": "Versions exactes de la stack commune.",
      "customType": "jsonata",
      "fileFormat": "json",
      "managerFilePatterns": ["/^packages/config/stack\\.json$/"],
      "matchStrings": ["$each($, function($v, $k) { { \"depName\": $k, \"currentValue\": $v } })"],
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "Une seule PR pour toute la stack : stack.json et les dépendances du kit restent alignés (hgdc-stack check).",
      "matchDatasources": ["npm"],
      "groupName": "stack HGDC",
      "addLabels": ["stack"]
    }
  ]
}
